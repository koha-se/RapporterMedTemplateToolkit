[% USE date(format = '%Y-%m-%d') %]
<!DOCTYPE html>
<html>
<head>

<title>
[% data.0.listname %] [% date.format(dateformat => 'iso') %]
</title>

<style>

@media print {

   .grid{
    display: block;
  }

  .book{
    page-break-inside: avoid;
    break-inside: avoid;
    margin-bottom: 20px;
  }

}

body{
  font-family: Arial, Helvetica, sans-serif;
}

h1{
  text-align:center;
  margin-bottom:25px;
}

.grid{
  display:grid;
  grid-template-columns:repeat(2, 1fr);
  gap:30px 25px;
  }

.book{
  display:flex;
  gap:12px;
}

.number{
  font-weight:bold;
  color:#666;
  width:25px;
}

.cover img{
  width:90px;
  height:130px;
  object-fit:cover;
}

.info{
  font-size:13px;
  line-height:1.3;
}

.title{
  font-weight:bold;
}

.author{
  font-style:italic;
}

.meta{
  margin-top:4px;
  color:#444;
  font-size:12px;
}

.abstract{
  margin-top:5px;
  font-size:12px;
}

.qr img{
  width:55px;
  margin-top:4px;
  display:block;
}

.footer{
  text-align:center;
  margin-top:30px;
}

.footer img{
  width:100%;
  max-width:300px;
  height:auto;
}

</style>
</head>

<body>

<h1>[% data.0.listname %]</h1>

<div class="grid">

[% FOREACH biblio IN data %]

<div class="book">

<div class="number">
[% loop.count %]
</div>

<div class="cover">
<img src="https://www.bokinfo.se/Images/Products/Medium/[% biblio.isbn.substr(0,6) %]/[% biblio.isbn %].jpg"
alt="[% biblio.title %]"
onerror="this.onerror=null;this.src='https://bibliotekmellansjo.se/cgi-bin/koha/opac-retrieve-file.pl?id=095fe8f564a88cd624ad133b48d33d90';">
</div>

<div class="info">

<div class="author">
[% biblio.author %]
</div>

<div class="title">
[% biblio.title %]
</div>

<div class="meta">
[% biblio.copyrightdate %] • [% biblio.pages %] 
</div>

<div class="qr">
<img src="https://api.qrserver.com/v1/create-qr-code/?data=https://bibliotekmellansjo.se/cgi-bin/koha/opac-detail.pl?biblionumber=[% biblio.biblionumber %]&size=150x150">
</div>

<div class="abstract">
[% biblio.abstract.substr(0,400) %]
[% IF biblio.abstract.length > 400 %]...[% END %]
</div>

</div>

</div>

[% END %]

</div>

</body>
</html>
